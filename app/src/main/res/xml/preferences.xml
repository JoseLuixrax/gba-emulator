<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:title="@string/pref_cat_video">
        <ListPreference
            app:defaultValue="sharp"
            app:entries="@array/video_filter_entries"
            app:entryValues="@array/video_filter_values"
            app:iconSpaceReserved="false"
            app:key="video_filter"
            app:title="@string/pref_video_filter"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            app:defaultValue="none"
            app:entries="@array/video_effect_entries"
            app:entryValues="@array/video_effect_values"
            app:iconSpaceReserved="false"
            app:key="video_effect"
            app:title="@string/pref_video_effect"
            app:useSimpleSummaryProvider="true" />
        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:iconSpaceReserved="false"
            app:key="color_correction"
            app:summary="@string/pref_color_correction_summary"
            app:title="@string/pref_color_correction" />
        <ListPreference
            app:defaultValue="keep"
            app:entries="@array/aspect_entries"
            app:entryValues="@array/aspect_values"
            app:iconSpaceReserved="false"
            app:key="aspect_mode"
            app:title="@string/pref_aspect"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            app:defaultValue="auto"
            app:entries="@array/orientation_entries"
            app:entryValues="@array/orientation_values"
            app:iconSpaceReserved="false"
            app:key="orientation"
            app:title="@string/pref_orientation"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            app:defaultValue="0"
            app:entries="@array/frameskip_entries"
            app:entryValues="@array/frameskip_values"
            app:iconSpaceReserved="false"
            app:key="frameskip"
            app:title="@string/pref_frameskip"
            app:useSimpleSummaryProvider="true" />
        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:iconSpaceReserved="false"
            app:key="show_fps"
            app:title="@string/pref_show_fps" />
    </PreferenceCategory>

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:title="@string/pref_cat_audio">
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:iconSpaceReserved="false"
            app:key="audio_enabled"
            app:title="@string/pref_audio_enabled" />
        <SeekBarPreference
            android:max="100"
            app:defaultValue="100"
            app:dependency="audio_enabled"
            app:iconSpaceReserved="false"
            app:key="audio_volume"
            app:showSeekBarValue="true"
            app:title="@string/pref_audio_volume" />
    </PreferenceCategory>

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:title="@string/pref_cat_controls">
        <SeekBarPreference
            android:max="100"
            app:defaultValue="55"
            app:iconSpaceReserved="false"
            app:key="pad_opacity"
            app:showSeekBarValue="true"
            app:title="@string/pref_pad_opacity" />
        <SeekBarPreference
            android:max="150"
            app:defaultValue="100"
            app:iconSpaceReserved="false"
            app:key="pad_scale"
            app:min="50"
            app:showSeekBarValue="true"
            app:title="@string/pref_pad_scale" />
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:iconSpaceReserved="false"
            app:key="haptics"
            app:title="@string/pref_haptics" />
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:iconSpaceReserved="false"
            app:key="dpad_diagonals"
            app:summary="@string/pref_dpad_diagonals_summary"
            app:title="@string/pref_dpad_diagonals" />
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:iconSpaceReserved="false"
            app:key="ff_toggle"
            app:summaryOff="@string/pref_ff_toggle_off"
            app:summaryOn="@string/pref_ff_toggle_on"
            app:title="@string/pref_ff_toggle" />
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:iconSpaceReserved="false"
            app:key="hide_pad_gamepad"
            app:summary="@string/pref_hide_pad_gamepad_summary"
            app:title="@string/pref_hide_pad_gamepad" />
        <Preference
            app:iconSpaceReserved="false"
            app:key="key_mapping"
            app:summary="@string/pref_key_mapping_summary"
            app:title="@string/key_mapping" />
        <Preference
            app:iconSpaceReserved="false"
            app:key="reset_layout"
            app:summary="@string/pref_reset_layout_summary"
            app:title="@string/pref_reset_layout" />
    </PreferenceCategory>

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:title="@string/pref_cat_emulation">
        <ListPreference
            app:defaultValue="4"
            app:entries="@array/ff_speed_entries"
            app:entryValues="@array/ff_speed_values"
            app:iconSpaceReserved="false"
            app:key="ff_speed"
            app:title="@string/pref_ff_speed"
            app:useSimpleSummaryProvider="true" />
        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:iconSpaceReserved="false"
            app:key="rewind_enabled"
            app:summary="@string/pref_rewind_summary"
            app:title="@string/pref_rewind" />
        <ListPreference
            app:defaultValue="20"
            app:dependency="rewind_enabled"
            app:entries="@array/rewind_entries"
            app:entryValues="@array/rewind_values"
            app:iconSpaceReserved="false"
            app:key="rewind_seconds"
            app:title="@string/pref_rewind_seconds"
            app:useSimpleSummaryProvider="true" />
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:iconSpaceReserved="false"
            app:key="auto_save_state"
            app:summary="@string/pref_auto_save_summary"
            app:title="@string/pref_auto_save" />
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:iconSpaceReserved="false"
            app:key="auto_load_state"
            app:summary="@string/pref_auto_load_summary"
            app:title="@string/pref_auto_load" />
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:iconSpaceReserved="false"
            app:key="idle_loop"
            app:summary="@string/pref_idle_loop_summary"
            app:title="@string/pref_idle_loop" />
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:iconSpaceReserved="false"
            app:key="gb_colorize"
            app:summary="@string/pref_gb_colorize_summary"
            app:title="@string/pref_gb_colorize" />
        <SeekBarPreference
            android:max="300"
            app:defaultValue="100"
            app:iconSpaceReserved="false"
            app:key="gyro_sensitivity"
            app:min="10"
            app:showSeekBarValue="true"
            app:summary="@string/pref_gyro_summary"
            app:title="@string/pref_gyro" />
    </PreferenceCategory>

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:title="@string/pref_cat_bios">
        <Preference
            app:iconSpaceReserved="false"
            app:key="bios_file"
            app:title="@string/pref_bios" />
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:iconSpaceReserved="false"
            app:key="skip_bios"
            app:summary="@string/pref_skip_bios_summary"
            app:title="@string/pref_skip_bios" />
    </PreferenceCategory>

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:title="@string/pref_cat_about">
        <Preference
            app:iconSpaceReserved="false"
            app:key="about"
            app:title="@string/app_name" />
        <Preference
            app:iconSpaceReserved="false"
            app:key="licenses"
            app:summary="@string/pref_licenses_summary"
            app:title="@string/pref_licenses" />
    </PreferenceCategory>
</PreferenceScreen>
